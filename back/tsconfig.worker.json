{
    "compilerOptions": {
        "jsx": "react-jsx",
        "jsxImportSource": "hono/jsx",
        "lib": ["ESNext"],
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "skipLibCheck": true,
        "strict": true,
        "target": "ESNext",
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.worker.tsbuildinfo",
        "types": ["./worker-configuration.d.ts"]
    },
    "extends": "./tsconfig.node.json",
    "include": ["src"]
}
