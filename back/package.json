{
    "dependencies": {
        "hono": "^4"
    },
    "devDependencies": {
        "@eslint/compat": "^2",
        "@robo-manager/eslint-config": "*",
        "@types/node": "^24",
        "eslint": "^9",
        "jiti": "^2",
        "npm-run-all2": "^8",
        "typescript": "^5",
        "wrangler": "^4"
    },
    "engines": {
        "node": ">=24.0.0",
        "npm": "use yarn instead",
        "pnpm": "use yarn instead",
        "yarn": ">=4.0.0"
    },
    "name": "@robo-manager/back",
    "packageManager": "yarn@4.12.0",
    "private": true,
    "scripts": {
        "build": ":",
        "deploy": "wrangler deploy --minify",
        "dev": "wrangler dev",
        "lint": "eslint --cache --cache-location ./node_modules/.cache/eslint/ --no-warn-ignored ./**/*.{ts,vue}",
        "lint:fix": "eslint --cache --cache-location ./node_modules/.cache/eslint/ --fix --no-warn-ignored ./**/*.{ts,vue}",
        "typecheck": "tsc",
        "typegen": "wrangler types --env-interface CloudflareBindings"
    },
    "type": "module",
    "version": "0.0.0"
}
